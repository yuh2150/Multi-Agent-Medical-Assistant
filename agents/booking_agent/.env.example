# Cấu hình Backend API Base URL
BACKEND_API_URL=http://localhost:3000

# Cấu hình Timezone (Chuẩn hóa Asia/Ho_Chi_Minh)
TIMEZONE=Asia/Ho_Chi_Minh

# Cấu hình HTTP client
HTTP_TIMEOUT=10.0
HTTP_MAX_RETRIES=3

# --- PHƯƠNG ÁN 1: Sử dụng OpenAI chuẩn ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini

# --- PHƯƠNG ÁN 2: Sử dụng Azure OpenAI (Mặc định của dự án hiện tại) ---
# deployment_name=your_azure_deployment_name
# model_name=your_azure_model_name
# azure_endpoint=https://your-endpoint.openai.azure.com/
# openai_api_key=your_azure_api_key
# openai_api_version=2023-05-15
